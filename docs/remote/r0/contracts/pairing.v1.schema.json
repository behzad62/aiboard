{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp.aiboard.me/schemas/v1/pairing.v1.schema.json",
  "title": "Relay pairing v1",
  "description": "HTTP bodies only; signatures, duplicate keys, size, expiry, status codes and origin binding require protocol validation.",
  "oneOf": [
    {
      "$ref": "#/$defs/startRequest"
    },
    {
      "$ref": "#/$defs/startResponse"
    },
    {
      "$ref": "#/$defs/pollRequest"
    },
    {
      "$ref": "#/$defs/pollResponse"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "startRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "deviceId",
        "publicKey",
        "name",
        "platform",
        "runnerVersion",
        "issuedAt",
        "nonce",
        "signature"
      ],
      "properties": {
        "protocolVersion": {
          "const": "1.0.0"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^device-[0-9a-f-]{36}$"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "pattern": "^[ -~]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "platform": {
          "enum": [
            "win32",
            "darwin",
            "linux"
          ]
        },
        "runnerVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,64}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "startResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairingId",
        "pollSecret",
        "userCode",
        "verificationUri",
        "expiresAt",
        "intervalSeconds"
      ],
      "properties": {
        "pairingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        "pollSecret": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "userCode": {
          "type": "string",
          "pattern": "^[BCDFGHJKLMNPQRSTVWXZ]{4}-[BCDFGHJKLMNPQRSTVWXZ]{4}$"
        },
        "verificationUri": {
          "type": "string",
          "pattern": "^(https://[^/?#]+|http://127\\.0\\.0\\.1(?::[0-9]+)?)/pair$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "pollRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairingId",
        "pollSecret"
      ],
      "properties": {
        "pairingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        "pollSecret": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "relayKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "publicKey"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "deviceSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountId",
        "clientId",
        "scope",
        "issuedAt",
        "relayKeys",
        "authorizedScopes",
        "relayOrigin",
        "envelopeKeyId",
        "envelopeSignature"
      ],
      "properties": {
        "accountId": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "clientId": {
          "const": "runner"
        },
        "scope": {
          "const": "aiboard.remote"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "relayKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/relayKey"
          }
        },
        "authorizedScopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[\\x21-\\x7e]+$",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "relayOrigin": {
          "type": "string",
          "pattern": "^(https://[^/?#]+|http://127\\.0\\.0\\.1(?::[0-9]+)?)$",
          "minLength": 1,
          "maxLength": 512
        },
        "envelopeKeyId": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "envelopeSignature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "pollResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "denied",
                "expired",
                "slow_down"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "session"
          ],
          "properties": {
            "status": {
              "const": "approved"
            },
            "session": {
              "$ref": "#/$defs/deviceSession"
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "enum": [
            "invalid_request",
            "invalid_signature",
            "conflict",
            "rate_limited",
            "not_found"
          ]
        }
      }
    }
  },
  "$comment": "Synthetic fixture root fixture-root-v1, Ed25519 SPKI base64url: MCowBQYDK2VwAyEA2iGVHe4BY3kXUV7puLW7-1iwIikyNO573JUwPGP0z-A"
}
