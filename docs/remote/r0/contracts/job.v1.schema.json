{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json",
  "title": "RemoteJob",
  "description": "Runner-authoritative durable job record, as proposed by ADR-C.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "jobId",
    "principal",
    "idempotencyKey",
    "payloadDigest",
    "toolId",
    "operationClass",
    "scopeRef",
    "state",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "protocolVersion": {
      "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/protocolVersion"
    },
    "jobId": {
      "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/id"
    },
    "principal": {
      "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/principal"
    },
    "idempotencyKey": {
      "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/id"
    },
    "payloadDigest": {
      "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/sha256"
    },
    "toolId": {
      "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/id"
    },
    "operationClass": {
      "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/id"
    },
    "scopeRef": {
      "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/id"
    },
    "state": {
      "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/jobState"
    },
    "createdAt": {
      "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/utcTimestamp"
    },
    "updatedAt": {
      "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/utcTimestamp"
    },
    "resultExpiresAt": {
      "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/utcTimestamp"
    },
    "cancellation": {
      "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/cancellation"
    },
    "outputRef": {
      "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/opaque"
    }
  },
  "$defs": {
    "protocolVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^1\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "opaque": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "utcTimestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 30,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "positiveDecimal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 19,
      "pattern": "^[1-9][0-9]*$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountId",
        "clientId",
        "deviceId"
      ],
      "properties": {
        "accountId": {
          "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/id"
        },
        "clientId": {
          "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/id"
        },
        "deviceId": {
          "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/id"
        }
      }
    },
    "remoteJobState": {
      "type": "string",
      "maxLength": 64,
      "enum": [
        "queued",
        "awaiting_device",
        "awaiting_approval",
        "running",
        "completed",
        "failed",
        "cancelled",
        "outcome_unknown",
        "blocked_policy",
        "blocked_quota"
      ]
    },
    "jobState": {
      "type": "string",
      "maxLength": 64,
      "enum": [
        "queued",
        "awaiting_approval",
        "running",
        "completed",
        "failed",
        "cancelled",
        "outcome_unknown",
        "blocked_policy",
        "blocked_quota"
      ]
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedAt",
        "stop",
        "effect"
      ],
      "properties": {
        "requestedAt": {
          "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/utcTimestamp"
        },
        "stop": {
          "type": "string",
          "maxLength": 64,
          "enum": [
            "pending",
            "stopped",
            "unverified",
            "not_applicable"
          ]
        },
        "effect": {
          "type": "string",
          "maxLength": 64,
          "enum": [
            "pending",
            "no_effect",
            "known",
            "effect_outcome_unknown"
          ]
        }
      }
    },
    "jobView": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authoritative",
            "job"
          ],
          "properties": {
            "authoritative": {
              "const": true
            },
            "job": {
              "$ref": "#"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authoritative",
            "jobId",
            "state"
          ],
          "properties": {
            "authoritative": {
              "const": false
            },
            "jobId": {
              "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/id"
            },
            "state": {
              "type": "string",
              "maxLength": 32,
              "const": "awaiting_device"
            },
            "lastKnownState": {
              "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/jobState"
            },
            "lastKnownAt": {
              "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/utcTimestamp"
            }
          }
        }
      ]
    },
    "cancelReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "cancelRequestId",
        "traceId",
        "delivery"
      ],
      "properties": {
        "jobId": {
          "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/id"
        },
        "cancelRequestId": {
          "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/id"
        },
        "traceId": {
          "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/id"
        },
        "delivery": {
          "type": "string",
          "maxLength": 64,
          "enum": [
            "pending_device",
            "recorded",
            "rejected"
          ]
        },
        "cancellation": {
          "$ref": "https://mcp.aiboard.me/schemas/v1/job.v1.schema.json#/$defs/cancellation"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "delivery": {
                "const": "pending_device"
              }
            },
            "required": [
              "delivery"
            ]
          },
          "then": {
            "not": {
              "type": "object",
              "properties": {
                "cancellation": {}
              },
              "required": [
                "cancellation"
              ]
            }
          }
        }
      ]
    }
  }
}
