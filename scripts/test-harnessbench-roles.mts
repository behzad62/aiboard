import assert from "node:assert/strict";
import { createWorkBenchTeamComposition, signatureBenchmarkModel, runSelected } from "../lib/benchmark/certified/run-execution";
import { normalizeWorkBenchModelSelection } from "../lib/benchmark/workbench/ui-selection";
import { BENCHMARK_PRESETS } from "../lib/benchmark/certified/run-presets";
import { HARNESSBENCH_SUITE } from "../lib/benchmark/native-suites";
import { getNativeToolBenchPack, NATIVE_TOOLBENCH_SUITE } from "../lib/benchmark/toolreliability/native-cases";
import { getTrustedBenchRunnerReadiness } from "../lib/client/bench-runner";
const models = [{ modelId: "test:a", providerId: "test", displayName: "A" }, { modelId: "test:b", providerId: "test", displayName: "B" }];
const allSame = createWorkBenchTeamComposition({ models: [models[0], models[0], models[0]], roleMode: "architect_worker_reviewer", effortByModelId: {} });
assert.deepEqual(allSame.roles.map(role => role.role), ["architect", "worker", "reviewer"]);
assert.equal(signatureBenchmarkModel(allSame, "harnessbench")?.modelId, "test:a");
assert.equal(signatureBenchmarkModel(allSame, "teamiq"), undefined);
const mixed = createWorkBenchTeamComposition({ models: [models[0], models[1], models[0]], roleMode: "architect_worker_reviewer", effortByModelId: {} });
assert.equal(signatureBenchmarkModel(mixed, "harnessbench"), undefined);
assert.deepEqual(normalizeWorkBenchModelSelection({ models, selectedModelIds: ["test:a", "test:a", "test:a"], roleMode: "architect_worker_reviewer" }), ["test:a", "test:a", "test:a"]);
assert.deepEqual(normalizeWorkBenchModelSelection({ models, selectedModelIds: ["test:a", "", "test:b"], roleMode: "architect_worker_reviewer" }), ["test:a", "", "test:b"], "Empty Worker selection cannot shift Reviewer into its slot.");
assert.deepEqual(BENCHMARK_PRESETS.map(p => p.title), ["HarnessBench", "ToolBench"]);
assert.equal(BENCHMARK_PRESETS[0].legs[0].mode, "team");
assert.equal(BENCHMARK_PRESETS[0].legs[0].includeSoloBaselines, false);
assert.equal(BENCHMARK_PRESETS[1].legs[0].mode, "solo");
const toolCase = getNativeToolBenchPack(NATIVE_TOOLBENCH_SUITE)!.cases[0].case;
assert.match(getTrustedBenchRunnerReadiness({ ok: true, runnerV2: { ready: true } }, toolCase).error ?? "", /solo native sessions/);
let message = ""; let called = false;
await runSelected({ selectedTrack: "harnessbench", suiteId: HARNESSBENCH_SUITE, models, workBenchModelIds: ["test:a"], setMessage: (value: string) => { message = value; }, runNativeWorkBenchBuild: async () => { called = true; } } as never);
assert.match(message, /Architect, Worker, and Reviewer\/Verifier/);
assert.equal(called, false, "Invalid role configuration stops before model or runner work.");
console.log("PASS fixed HarnessBench roles, same-model configurations, mixed teams and preflight");
