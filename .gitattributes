# Frozen RJS inputs and calibration evidence are identified by exact bytes.
# Preserve their qualified line endings on every checkout platform.
benchmarks/recoverable-job-service/** -text
docs/benchmarks/recoverable-job-service/** -text
docs/superpowers/specs/2026-09-08-recoverable-job-service-benchmark-design.md -text

# Runtime asset hashes bind LF sources and exact executable bytes.
runner-v2/src/windows-birth/*.mjs text eol=lf
runner-v2/src/windows-birth/*.cs text eol=lf
runner-v2/src/windows-birth/*.json text eol=lf
runner-v2/src/windows-birth/native/** binary

# One-line installers are served to sh and PowerShell as rendered; keep the templates LF everywhere.
scripts/install/* text eol=lf

# Signed release manifests are verified byte for byte; never convert their line endings.
public/release/** -text
