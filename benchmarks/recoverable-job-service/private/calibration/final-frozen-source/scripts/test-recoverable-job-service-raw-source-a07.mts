import assert from 'node:assert/strict';import {readFile,writeFile} from 'node:fs/promises';import {evaluateBounded,createReplayInput} from '../benchmarks/recoverable-job-service/private/runtime.mjs';import {controls} from '../benchmarks/recoverable-job-service/private/controls.mjs';import {variants} from '../benchmarks/recoverable-job-service/private/variants.mjs';import {matchesMaterialFailure} from '../benchmarks/recoverable-job-service/private/material-failure.mjs';
