import {parseRecoverableJobServiceDiagnostics} from '../lib/benchmark/workbench/recoverable-job-service/diagnostics';
import assert from 'node:assert/strict';
import {readFile} from 'node:fs/promises';
import {Broker,canonical} from '../benchmarks/recoverable-job-service/private/broker.mjs';
import {Scenario} from '../benchmarks/recoverable-job-service/private/scenarios.mjs';
import {evaluate} from '../benchmarks/recoverable-job-service/private/evaluator.mjs';
import {Guest} from '../benchmarks/recoverable-job-service/private/guest.mjs';
import {evaluateBounded} from '../benchmarks/recoverable-job-service/private/runtime.mjs';
import {effectiveProvenance,schedulePlan} from '../benchmarks/recoverable-job-service/private/provenance.mjs';
import {inspectSafety} from '../benchmarks/recoverable-job-service/private/oracle.mjs';
const reference=await readFile(new URL('../benchmarks/recoverable-job-service/private/reference.js',import.meta.url),'utf8');
const tests:Record<string,()=>Promise<void>>={};
const scenario=async(fn:(s:any)=>Promise<void>,source=reference)=>{const s=await new Scenario(source,'fix3',{wallMs:10000}).open();try{await fn(s);}finally{await s.dispose();}};
const raw=async(fn:(b:any)=>Promise<void>)=>{const b=new Broker();try{await fn(b);}finally{await b.shutdown();}};
tests['C1-substituted-isolation-release']=async()=>{const bad=reference.replace("const call=(m,a={})=>p.call(m,a)","const call=(m,a={})=>m==='driver.release'&&a.resource==='isolation'?Promise.resolve({kind:'applied',value:a.acquired}):p.call(m,a)");const r=await evaluate(bad,{families:['D01'],wallMs:5000});assert.equal(r.status,'valid');assert.equal(r.families[0].passed,false);assert(r.safetyFailures.some((x:any)=>/resource|release|conjunction/.test(x.code)));};
tests['C2-missing-evidence-candidate']=async()=>{const source=reference+'\nconst factory=createService;globalThis.createService=async(...a)=>{const s=await factory(...a),run=s.run;s.run=async q=>{const r=await run(q);if(q.type==="inspectJob"&&r.kind==="ok")delete r.value.evidence;return r;};return s;};';const r=await evaluate(source,{families:['A05'],wallMs:5000});assert.equal(r.status,'valid');assert.equal(r.families[0].passed,false);};
tests['I1-claim-replay']=()=>raw(async b=>{const args={name:'holder',expected:0,operationId:b.id(),fence:{grant:b.grant,deadline:1000},value:{holder:b.grant.holder,logicalOwner:b.grant.ownerId,epoch:b.grant.epoch}};const a=await b.call('claims.cas',args),again=await b.call('claims.cas',args);assert.deepEqual(again,a);});
tests['I1-claim-forgery']=()=>raw(async b=>{const r=await b.call('claims.cas',{name:'holder',expected:0,operationId:b.id(),fence:{grant:b.grant,deadline:1000},value:{holder:{...b.grant.holder,birth:b.id()},logicalOwner:b.id(),epoch:999}});assert.notEqual(r.kind,'applied');assert.equal(b.claims.size,0);});
tests['I1-cross-job-control']=()=>raw(async b=>{const a=b.id(),c=b.id(),fence={grant:b.grant,deadline:1000};await b.call('driver.acquire',{jobId:a,resource:'process',operationId:b.id(),fence});await b.call('driver.acquire',{jobId:c,resource:'process',operationId:b.id(),fence});const r=await b.call('driver.control',{jobId:a,target:b.getJob(c).workload,signal:'force',operationId:b.id(),fence});assert.notEqual(r.kind,'applied');assert.equal(b.getJob(a).forceCount,0);});
tests['I1-audit-atomicity']=()=>raw(async b=>{const before=canonical({revision:b.revision,docs:[...b.docs],audit:b.audit});await assert.rejects(b.call('store.commit',{writes:[{key:'x',expected:0,value:1}],audit:[null],operationId:b.id(),fence:{grant:b.grant,deadline:1000}}));assert.equal(canonical({revision:b.revision,docs:[...b.docs],audit:b.audit}),before);});
tests['I1-root-complete-identity']=()=>raw(async b=>{const fence={grant:b.grant,deadline:1000},root=(await b.call('artifact.create',{path:'scratch/a',owner:b.id(),retained:false,operationId:b.id(),fence})).value;const r=await b.call('artifact.remove',{root:{...root,retained:true,path:'elsewhere'},operationId:b.id(),fence});assert.notEqual(r.kind,'applied');assert.equal(b.physicalRemovals,0);});
tests['I2-rejected-release-reopen']=()=>scenario(async s=>{await s.setup();s.b.fault('driver.release.after','throw',{value:false});await s.refuse('stop',{jobId:s.jobId});await s.reopen();await s.finish();assert.equal(s.count('driver.release'),2);});
tests['I2-inspection-retained-after-timeout']=()=>scenario(async s=>{await s.setup();const h=await s.hold('driver.inspect.before',()=>s.run('stop',{jobId:s.jobId,deadline:1000}));s.b.tick(1000);await h.pending;const second=s.run('stop',{jobId:s.jobId,deadline:2000});await new Promise(r=>setTimeout(r,5));assert.equal(s.b.trace.filter((x:any)=>x.method==='driver.inspect.before').length,1);h.resume();assert.equal((await second).kind,'ok');});
tests['I3-expired-completed-replay']=()=>scenario(async s=>{const req={requestId:s.b.id(),deadline:1000};const a=await s.run('createBatch',req);s.b.tick(1001);await s.reopen();assert.deepEqual(await s.run('createBatch',req),a);});
tests['I3-service-close-admission']=()=>scenario(async s=>{await s.setup();await s.ok('close');await s.reopen();await s.refuse('createBatch',{},['dependency']);});
tests['I4-future-checkpoint']=()=>scenario(async s=>{await s.setup();const cap=await s.ok('exportCapsule',{jobId:s.jobId});cap.checkpoint.createdAt=s.b.time+1;await s.refuse('restore',{capsule:await s.sealed(cap)},['integrity']);});
tests['I4-handoff-self']=()=>scenario(async s=>{await s.setup();await s.refuse('handoff',{setupId:s.setupId,successorJobId:s.jobId},['dependency']);});

tests['bridge-resolver-failure-disposes']=()=>raw(async b=>{const g=await Guest.open('globalThis.createService=async()=>({run:async()=>({kind:"ok",value:null})});',b);try{const deferred=g.vm.newPromise(),entry={deferred,method:'probe'};g.pending.add(entry);deferred.resolve=()=>{throw Error('injected resolver failure');};g.settle(entry,true,{value:1});assert.equal(deferred.alive,false);assert.equal(g.pending.size,0);assert.match(g.error.message,/injected resolver failure/);}finally{g.dispose();}});
tests['whole-watchdog-valid-candidate-failure']=async()=>{const began=Date.now();const r=await evaluateBounded('globalThis.createService=async()=>({run:()=>new Promise(()=>{})});',{families:['A01'],wallMs:1000,totalWallMs:80});assert.equal(r.status,'valid');assert.equal(r.resolved,false);assert(r.families.some((f:any)=>f.reason.includes('whole-evaluation watchdog')));assert(r.families.flatMap((f:any)=>f.variants).some((v:any)=>!v.safetyChecked));assert(Date.now()-began<2500);};
tests['provenance-effective-options']=async()=>{const a=effectiveProvenance({families:['B14'],largeCount:65}),b=effectiveProvenance({families:['B14'],largeCount:1025});assert.notEqual(a.configurationHash,b.configurationHash);assert.notEqual(a.configurationHash,effectiveProvenance({families:['B14'],largeCount:65,wallMs:1000}).configurationHash);assert.deepEqual(schedulePlan('same'),schedulePlan('same'));assert.notDeepEqual(schedulePlan('same'),schedulePlan('different'));assert.throws(()=>effectiveProvenance({mode:'production',largeCount:65}));};
for(const [name,family,mutate] of [
 ['empty-legacy-evidence-spans','C11',"if(q.type==='readEvidence'&&r.kind==='ok')r.value.manifest.spans=[];"],
 ['missing-failure-array','A05',"if(q.type==='inspectJob'&&r.kind==='ok')delete r.value.failures;"],
 ['malformed-evidence-totals','A05',"if(q.type==='inspectJob'&&r.kind==='ok')r.value.evidence.totals=null;"],
 ['malformed-consumer-receipt','A05',"if(q.type==='consume'&&r.kind==='ok')r.value.payload=null;"],
 ['malformed-export-checkpoint','C05',"if(q.type==='exportCapsule'&&r.kind==='ok')r.value.checkpoint.accepted=null;"],
] as const)tests['C2-'+name]=async()=>{const source=reference+'\n{const f=createService;globalThis.createService=async(...a)=>{const s=await f(...a),run=s.run;s.run=async q=>{const r=await run(q);'+mutate+'return r;};return s;};}';const r=await evaluate(source,{families:[family],variantIds:[family+'/primary'],wallMs:3000});assert.equal(r.status,'valid');assert.equal(r.families[0].passed,false);};

tests['bridge-dump-failure-disposes']=()=>raw(async b=>{const g=await Guest.open('globalThis.createService=async()=>({run:async()=>({kind:"ok",value:null})});',b);const h=g.vm.newObject(),dump=g.vm.dump;try{g.vm.dump=()=>{throw Error('injected dump failure');};assert.throws(()=>g.dumpOwned(h),/injected dump failure/);assert.equal(h.alive,false);}finally{g.vm.dump=dump;g.dispose();}});
tests['disposal-error-still-joins-host']=async()=>{const s=new Scenario(reference,'C01',{wallMs:3000});await s.open();s.b.fault('store.read.before','hold');const p=s.g.code('return ports.call("store.read",{key:"held"});');p.catch(()=>{});await new Promise(r=>setImmediate(r));const original=s.g.dispose.bind(s.g);s.g.dispose=()=>{original();throw Error('injected disposal error');};await assert.rejects(()=>s.dispose(),/injected disposal error/);await p.catch(()=>{});assert.equal(s.b.active.size,0);assert.equal(s.b.held.size,0);};
tests['C2-long-throw-diagnostics']=async()=>{for(const source of ['globalThis.createService=async()=>{throw new Error("x".repeat(9000))};','globalThis.createService=async()=>({run:async()=>{throw new Error("x".repeat(9000))}});']){const r=await evaluate(source);assert.equal(r.status,'valid');assert.equal(r.resolved,false);assert.equal(parseRecoverableJobServiceDiagnostics(r).ok,true,'long candidate error remains valid parsed failure');}};
const selected=Object.entries(tests).filter(([name])=>!process.argv[2]||name.startsWith(process.argv[2]));assert(selected.length>0);let failures=0;for(const [name,test] of selected){try{await test();console.log('PASS '+name);}catch(e){failures++;console.error('FAIL '+name+': '+(e as Error).message);}}console.log(selected.length+' selected, '+failures+' failed');if(failures)process.exitCode=1;
