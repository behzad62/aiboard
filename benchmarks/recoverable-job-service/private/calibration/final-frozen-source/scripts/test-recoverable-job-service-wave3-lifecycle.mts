import assert from 'node:assert/strict';import {readFile} from 'node:fs/promises';import {Scenario} from '../benchmarks/recoverable-job-service/private/scenarios.mjs';import {exerciseVariant,variants} from '../benchmarks/recoverable-job-service/private/variants.mjs';import {schedulePlan} from '../benchmarks/recoverable-job-service/private/provenance.mjs';
const source=await readFile('benchmarks/recoverable-job-service/private/reference.js','utf8'),failures=[];
for(const id of ['B04/primary','B05/primary','C05/version']){const v=schedulePlan('qualification-v1').find(v=>v.id===id),s=new Scenario(source,v.family,{seed:'qualification-v1',schedule:v.schedule});try{await s.open();await exerciseVariant(s,v);if(id.startsWith('B')){const detach=s.b.trace.findIndex(t=>t.type==='effect'&&t.method==='driver.detach');assert.ok(detach>=0);assert.equal(s.b.trace.filter(t=>t.type==='boundary'&&t.method==='driver.observeSource.before').length,0,'ordinary zero-origin retry has no added observation RPC');assert.equal(s.b.audit.filter(t=>t.type==='source-bootstrap').length,0);}else assert.ok(s.b.executedInput().events.some(e=>e.type==='request'&&e.request.type==='restore'&&e.request.capsule.format===2),'version negative uses explicitly unsupported format2');console.log(id,'PASS');}catch(error){failures.push(id+': '+error.message);console.log(id,'FAIL',error.message);}finally{await s.dispose();}}
assert.equal(failures.length,0,failures.join('; '));
